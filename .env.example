# Valores provisionales para N=0. Sustituir por 51N0 y 51N1 del grupo.
API_PORT=5100
FRONTEND_PORT=5101
API_ENV=dev
APP_VERSION=dev
DATABASE_TIMEOUT=5s
# Valores para la red aislada de Compose. En producción usar un secreto inyectado y TLS.
DATABASE_URL=postgres://plantillas@postgres:5432/plantillas?sslmode=disable
# Proveedor provisional. En producción usar el endpoint HTTPS confirmado por el curso.
AUTH_JWKS_URL=http://host.docker.internal:5102/.well-known/jwks.json
AUTH_ISSUER=http://localhost:5102
AUTH_AUDIENCE=plantillas-reporte
AUTH_ROLE_CLAIM=perfil
